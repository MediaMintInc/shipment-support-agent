# ---------------------------------------------------------------------------
# Model provider (used by `npm run agent` and `npm run eval`; NOT needed for `npm test`)
# ---------------------------------------------------------------------------
# One of: openai | anthropic | bedrock   (default: openai)
MODEL_PROVIDER=openai
# Default for openai: gpt-5.4
MODEL_ID=gpt-5.4
MODEL_MAX_TOKENS=4096
# Only sent when set. Leave EMPTY for GPT-5-family reasoning models (they reject non-default temperature).
MODEL_TEMPERATURE=

# OpenAI
OPENAI_API_KEY=
# responses (default; Responses API, stateless) | chat (Chat Completions)
OPENAI_API_MODE=responses
# Optional: none | minimal | low | medium | high (supported values depend on the model)
OPENAI_REASONING_EFFORT=
# Optional: OpenAI-compatible gateway/proxy base URL (e.g. https://my-gateway.example.com/v1)
OPENAI_BASE_URL=
OPENAI_ORG_ID=

# Alternative providers (not used when MODEL_PROVIDER=openai)
# ANTHROPIC_API_KEY=
# AWS_REGION=us-west-2
# AWS_PROFILE=

# Optional: per-million-token prices so eval reports can estimate cost (otherwise "unavailable")
# MODEL_INPUT_COST_PER_MTOK=3
# MODEL_OUTPUT_COST_PER_MTOK=15

# ---------------------------------------------------------------------------
# MCP server connections (stdio child processes). Paths are relative to the project root.
# ---------------------------------------------------------------------------
# SHIPMENT_MCP_COMMAND=node
SHIPMENT_MCP_ARGS=dist/mcp/shipment-server.js
# SUPPORT_MCP_COMMAND=node
SUPPORT_MCP_ARGS=dist/mcp/support-server.js
# Hard cap on tool calls per agent request
AGENT_MAX_TOOL_CALLS=8

# ---------------------------------------------------------------------------
# Backend services used by the MCP servers' adapters.
# Defaults point at the local mock (`npm run mock`, port 4010).
# ---------------------------------------------------------------------------
SHIPMENT_API_BASE_URL=http://127.0.0.1:4010/shipment-api
SUPPORT_API_BASE_URL=http://127.0.0.1:4010/support-api
BACKEND_API_TOKEN=
BACKEND_TIMEOUT_MS=5000
BACKEND_MAX_RETRIES=2
BACKEND_RETRY_BASE_DELAY_MS=200
BACKEND_RETRY_MAX_DELAY_MS=2000
# Comma-separated origins the adapters may call; empty = no restriction.
# (Evaluations always restrict this to the local mock automatically.)
BACKEND_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Evaluation harness (the mock backend URL is chosen automatically)
# ---------------------------------------------------------------------------
EVAL_BACKEND_TIMEOUT_MS=1000
EVAL_BACKEND_MAX_RETRIES=2
EVAL_BACKEND_RETRY_BASE_DELAY_MS=100
# Extra hosts the harness may reach besides loopback and the provider (e.g. a proxy)
EVAL_EXTRA_ALLOWED_HOSTS=

LOG_LEVEL=info
